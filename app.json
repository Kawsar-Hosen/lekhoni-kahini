{
  "expo": {
    "name": "Lekhoni Kahini",
    "slug": "lekhoni-kahini",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "com.lekhoni.kahini",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A1220"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.lekhoni.kahini",
      "versionCode": 5,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A1220"
      },
      "icon": "./assets/store-icon.png",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#4A1220"
      }
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Allow Lekhoni Kahini to access your photos for avatar and cover image"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.940343114841-pd5po6gp5dij90nlp5k28tigp5qqr1rt",
          "androidPackage": "com.lekhoni.kahini",
          "androidSha1": "BF306ABAE8D1650D973FE3E678A00A270A0BB40F"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "659b4215-d07c-41f8-881b-c3e7cd7e951a"
      },
      "googleClientId": "940343114841-h78drktn8bvgl0snv0sjujj7alne60ov.apps.googleusercontent.com"
    },
    "owner": "xyte"
  }
}
